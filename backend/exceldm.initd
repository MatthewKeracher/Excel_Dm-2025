#!/sbin/openrc-run

name=exceldm
description="Excel DM server"
command=/opt/exceldm/exceldm/backend/exceldm
command_background=true
pidfile=/run/exceldm.pid
output_log=/var/log/exceldm/app.log
error_log=/var/log/exceldm/app.log
directory=/opt/exceldm/exceldm/backend

export JWT_SECRET="change-this-to-a-secret"

depend() {
    need net
}
